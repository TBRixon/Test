# ============================================================
# RefiSight environment configuration
# Copy this file to .env — NEVER commit .env to source control
# ============================================================

# Flask secret key — change this to a long random string in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database
# Local dev:   leave unset (defaults to SQLite)
# Production:  set to your PostgreSQL URL from Railway / Render / Supabase
# DATABASE_URL=postgresql://user:password@host:5432/refisight

# Cotality (CoreLogic) AVM API
# Obtain from the Cotality developer portal
COTALITY_BASE_URL=https://api.cotality.com.au/v1
COTALITY_API_KEY=your_api_key_here
