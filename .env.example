# ============================================================
# Cotality (CoreLogic) AVM API credentials
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.
# ============================================================

# Base URL for the Cotality AVM API (no trailing slash)
COTALITY_BASE_URL=https://api.cotality.com.au/v1

# Your API key – obtain from the Cotality developer portal
COTALITY_API_KEY=your_api_key_here
